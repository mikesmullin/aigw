# Shared secret clients send as Authorization: Bearer …
# openssl rand -hex 32
LLM_PROXY_API_KEY=change-me-to-a-long-random-secret

# Bind address. Use a LAN IP so other machines can connect.
# If llama-server already owns 127.0.0.1:PORT on this host, do not bind 0.0.0.0
# (the two sockets can coexist on the same port only when the addresses differ).
HOST=127.0.0.1
PORT=1234

# Optional client IP allowlist (comma-separated CIDRs / IPs)
ALLOWED_CIDRS=127.0.0.1

# When the client omits model, AGL reads ~/.config/agl/config.yaml default_model.

# Fallback for the web-researcher proxy, used only when config.yaml has no `proxies:` key
# (config.yaml is the place to set it: proxies: { /search: http://127.0.0.1:2340 }).
SEARCH_UPSTREAM=http://127.0.0.1:2340
SEARCH_PATH=/search

# AGL project (credentials + Copilot token file)
AGL_DIR=../agl

# Local llama-server (loopback). Leave API key empty unless llama-server --api-key is set.
LLAMA_SERVER_BASE_URL=http://127.0.0.1:1234
# LLAMA_SERVER_API_KEY=

# TLS (scripts/gen-certs.sh writes tmp/certs/, which is gitignored). Empty TLS_CERT → HTTP.
TLS_CERT=tmp/certs/server.pem
TLS_KEY=tmp/certs/server.key
# TLS_CA=tmp/certs/ca.pem

# Used by scripts/gen-certs.sh (not required at runtime).
TLS_CA_CN=AI Gateway CA
TLS_SERVER_CN=localhost
TLS_DNS_NAMES=localhost
TLS_IP_ADDRS=127.0.0.1
