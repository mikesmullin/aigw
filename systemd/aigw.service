# AI Gateway — OpenAI-compatible LAN gateway (Bun CoffeeScript).
#
# Installation (from the repo root; substitutes this clone's path):
#   bun install
#   bash scripts/gen-certs.sh
#   bash scripts/install-systemd.sh
#   loginctl enable-linger "$USER"
#
# Logs:
#   journalctl --user -u aigw -f

[Unit]
Description=aigw - OpenAI-compatible LAN inference gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=/bin/bash -ic 'exec %h/.bun/bin/bun src/index.coffee'
Restart=on-failure
RestartSec=3
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-@REPO@/.env

[Install]
WantedBy=default.target
